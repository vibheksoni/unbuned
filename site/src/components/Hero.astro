---
import { repo, tagline } from '../data/site';

const facts = [
  { value: '1', label: 'Python file' },
  { value: '0', label: 'Things to install' },
  { value: '3.6+', label: 'Python version' },
  { value: '3', label: 'Operating systems' },
];

const output = [
  'Extracted: output/droid/droid.js',
  'Size: 14,102,812 bytes',
  'Container: pe (.bun section, 41,171,402 bytes at offset 114079744)',
  'JavaScript: 14,102,812 bytes at section offset 31',
  'Modules: 1',
  'Module graph: 20 embedded files',
  'Entry point: B:/~BUN/root/droid.exe',
  'Sources: 4331 original files recovered from 1 source maps',
];
---

<section class="hero" id="top">
  <div class="wrap">
    <h1>{tagline}</h1>
    <p class="lede">
      A Bun app is just JavaScript wrapped up in a binary. unbuned takes the wrapper off and writes the
      JavaScript to a file you can open, search and read.
    </p>
    <div class="actions">
      <a class="button primary" href={repo} rel="noopener">Get unbuned</a>
      <a class="button" href="#samples">See it on real apps</a>
    </div>

    <div class="term">
      <div class="bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="title">unbuned</span>
      </div>
      <div class="screen">
        <p class="line"><span class="prompt">$</span> python unbuned.py droid.exe</p>
        {output.map((l) => <p class="line out">{l}</p>)}
        <p class="line"><span class="prompt">$</span><span class="caret"></span></p>
      </div>
    </div>

    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt>{f.value}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    padding: 96px 0 64px;
  }

  h1 {
    font-size: clamp(36px, 6.6vw, 68px);
    max-width: 16ch;
    margin-bottom: 24px;
  }

  .lede {
    max-width: 60ch;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 32px 0 44px;
  }

  .term {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    background: #0a0a0b;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 11px 15px;
    border-bottom: 1px solid var(--border);
    background: #131316;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #2e2e34;
  }

  .title {
    margin-left: 10px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
  }

  .screen {
    padding: 20px 22px 22px;
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.75;
    overflow-x: auto;
  }

  .line {
    margin: 0;
    white-space: pre;
  }

  .out {
    color: var(--muted);
  }

  .prompt {
    color: var(--accent);
    margin-right: 10px;
  }

  .caret {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-left: 2px;
    vertical-align: -2px;
    background: var(--text);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 48px 0 0;
  }

  .facts div {
    display: grid;
    gap: 4px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .facts dt {
    font-family: var(--display);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .facts dd {
    margin: 0;
    color: var(--muted);
    font-size: 14.5px;
  }

  @media (max-width: 620px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
